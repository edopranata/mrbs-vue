# URL backend Laravel yang dipakai proxy Vite saat `npm run dev`.
VITE_BACKEND_URL=http://127.0.0.1:8000

# Base URL API yang dipanggil browser. Biarkan `/api` bila frontend & backend
# berada di domain yang sama (atau lewat proxy). Isi URL lengkap bila berbeda domain,
# misal: https://api-mrbs.kantor.co.id/api
VITE_API_URL=/api

# Folder tujuan `npm run build:laravel` (relatif terhadap folder frontend).
# Default: ../backend/public/app
# LARAVEL_APP_DIR=../backend/public/app
